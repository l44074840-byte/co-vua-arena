<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Cờ Vua Arena - Bản Demo</title>
<style>
:root{--bg:#111218;--panel:#1d202b;--text:#f7f7fb;--muted:#aeb3c5;--gold:#e8b85c;--light:#e8d8b5;--dark:#769656;--line:#34394a}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at top,#252a3b,#111218 65%);color:var(--text);font-family:system-ui,-apple-system,Segoe UI,sans-serif;min-height:100vh}
main{width:min(100%,760px);margin:auto;padding:16px}.panel{background:rgba(29,32,43,.96);border:1px solid var(--line);border-radius:18px;padding:18px;box-shadow:0 10px 35px #0004}
h1,h2{text-align:center;margin:6px 0 14px}h1{font-size:clamp(25px,6vw,36px);color:var(--gold)}h2{font-size:23px}.sub{text-align:center;color:var(--muted);margin:0 0 18px}
button,select,input{font:inherit}button{border:0;border-radius:12px;padding:12px 15px;background:var(--gold);color:#1b1b20;font-weight:750;cursor:pointer}button.secondary{background:#303647;color:var(--text);border:1px solid #454b60}button:disabled{opacity:.45;cursor:not-allowed}.actions{display:grid;gap:11px;max-width:380px;margin:20px auto}.hidden{display:none!important}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:center}.field{background:#151821;border:1px solid var(--line);border-radius:12px;padding:12px;margin:10px 0}.field label{display:block;margin-bottom:8px;color:var(--muted)}input[type=range]{width:100%;accent-color:var(--gold)}select{width:100%;padding:10px;background:#151821;color:var(--text);border:1px solid var(--line);border-radius:9px}
.choices{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.choices button{padding:14px 5px}.choices button.active{outline:3px solid #fff;outline-offset:1px}.board-wrap{max-width:560px;margin:12px auto}.statusbar{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;margin:8px 0}.pill{background:#151821;border:1px solid var(--line);border-radius:10px;padding:8px 11px;font-weight:700}.board{display:grid;grid-template-columns:repeat(8,1fr);width:100%;aspect-ratio:1;border:4px solid #252631;border-radius:7px;overflow:hidden;touch-action:manipulation}.sq{display:flex;align-items:center;justify-content:center;position:relative;font-size:clamp(25px,8vw,52px);line-height:1;cursor:pointer;user-select:none}.sq.light{background:var(--light)}.sq.dark{background:var(--dark)}.sq.selected{box-shadow:inset 0 0 0 4px #f4d35e}.sq.legal:after{content:"";width:25%;height:25%;border-radius:50%;background:#18201955;position:absolute}.sq.capture:after{content:"";position:absolute;inset:4px;border:4px solid #b22b2b99;border-radius:50%}.sq.last{background:#c9c34c}.piece.white{color:#fff;text-shadow:1px 2px 2px #222,-1px -1px 1px #222}.piece.black{color:#161616;text-shadow:0 1px 1px #fff9}.small{font-size:13px;color:var(--muted);text-align:center;line-height:1.5}.promo button{font-size:30px;min-width:65px}.message{text-align:center;font-size:19px;font-weight:800;margin:12px 0;color:var(--gold)}.moves{max-height:95px;overflow:auto;color:var(--muted);font-size:13px;text-align:center}.notice{background:#151821;border-radius:10px;padding:10px;margin:10px 0;color:var(--muted);font-size:14px}
@media(min-width:620px){.game-layout{display:grid;grid-template-columns:minmax(0,1fr) 190px;gap:15px;align-items:start}.side{padding-top:8px}}
</style>
</head>
<body><main>
<section id="home" class="panel">
<h1>♟ CỜ VUA ARENA</h1><p class="sub">Bản demo • Chơi cờ vua với máy tính</p>
<div class="actions"><button id="goSetup">BẮT ĐẦU</button><button id="goHelp" class="secondary">HƯỚNG DẪN CHƠI</button></div>
<p class="small">Âm thanh quân cờ • Chọn màu quân • Chọn Elo và thời gian</p>
</section>
<section id="setup" class="panel hidden">
<h2>Thiết lập ván cờ</h2><p class="sub">Chọn màu quân bạn muốn chơi</p>
<div class="choices"><button data-color="w" class="active">⚪ Trắng</button><button data-color="r">🎲 Ngẫu nhiên</button><button data-color="b">⚫ Đen</button></div>
<div class="field"><label for="elo">Độ khó AI: <b id="eloVal">1200 Elo</b></label><input id="elo" type="range" min="400" max="2500" step="100" value="1200"><div class="row" style="justify-content:space-between"><span class="small">400: dễ</span><span class="small">2500: khó</span></div></div>
<div class="field"><label for="time">Thời gian cho mỗi bên</label><select id="time"><option value="15">15 phút</option><option value="20">20 phút</option><option value="25">25 phút</option><option value="30">30 phút</option></select></div>
<div class="actions"><button id="startGame">BẮT ĐẦU CHƠI</button><button id="backHome" class="secondary">Quay lại màn hình chính</button></div>
</section>
<section id="help" class="panel hidden">
<h2>Hướng dẫn chơi cờ vua</h2>
<div class="notice"><b>Mục tiêu:</b> Chiếu hết vua đối phương để thắng. Bảo vệ vua của bạn và tìm cách chiếu hết vua máy.</div>
<div class="notice"><b>Cách đi quân:</b> Vua đi 1 ô; Hậu đi ngang, dọc, chéo; Xe đi ngang/dọc; Tượng đi chéo; Mã đi hình chữ L và có thể nhảy qua quân; Tốt thường đi thẳng 1 ô, lần đầu có thể đi 2 ô, ăn quân chéo.</div>
<div class="notice"><b>Cách chơi trên điện thoại:</b> Chạm vào quân của bạn, rồi chạm vào ô muốn đi. Các ô được đánh dấu là nước đi hợp lệ.</div>
<div class="notice"><b>Phong tốt:</b> Khi tốt tới cuối bàn, chọn Hậu, Xe, Tượng hoặc Mã.</div>
<div class="notice"><b>Độ khó:</b> Elo càng cao, máy tìm kiếm nhiều nước đi hơn và thường chơi mạnh hơn. Đây là bản demo nên Elo chỉ là mức độ khó mô phỏng, không phải xếp hạng chuẩn.</div>
<div class="actions"><button id="helpBack">Quay lại</button></div>
</section>
<section id="game" class="panel hidden">
<h2>Cờ Vua Arena</h2>
<div class="statusbar"><span class="pill" id="youSide">Bạn: Trắng</span><span class="pill" id="aiLevel">AI: 1200 Elo</span></div>
<div class="game-layout"><div><div class="statusbar"><span class="pill" id="turn">Lượt: Trắng</span><span class="pill" id="status">Đang chơi</span></div><div class="board-wrap"><div id="board" class="board"></div></div><div id="message" class="message"></div><div id="promotion" class="row promo hidden"><span>Chọn quân phong:</span></div><div class="moves" id="moves"></div></div>
<div class="side"><div class="field"><label>Đồng hồ của bạn</label><div id="yourClock" class="message">15:00</div></div><div class="field"><label>Đồng hồ máy</label><div id="aiClock" class="message">15:00</div></div><div class="actions"><button id="undo" class="secondary">Hoàn tác</button><button id="newGame" class="secondary">Ván mới</button><button id="mainMenu" class="secondary">Màn hình chính</button></div></div></div>
</section>
</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
<script>
(() => {
const $=id=>document.getElementById(id);
const screens=['home','setup','help','game'];
function show(id){screens.forEach(s=>$(s).classList.toggle('hidden',s!==id));}
let chosen='w', game=null, human='w', aiElo=1200, times={w:900,b:900}, timer=null, selected=null, legal=[], lastMove=null, ended=false, thinking=false, history=[];
const glyph={wk:'♔',wq:'♕',wr:'♖',wb:'♗',wn:'♘',wp:'♙',bk:'♚',bq:'♛',br:'♜',bb:'♝',bn:'♞',bp:'♟'};
function sound(kind='move'){
 try{const C=window.AudioContext||window.webkitAudioContext;const ctx=new C();const o=ctx.createOscillator(),g=ctx.createGain();o.connect(g);g.connect(ctx.destination);let f=kind==='capture'?190:kind==='check'?620:kind==='end'?420:330;o.frequency.value=f;o.type='sine';g.gain.setValueAtTime(.0001,ctx.currentTime);g.gain.exponentialRampToValueAtTime(.12,ctx.currentTime+.015);g.gain.exponentialRampToValueAtTime(.0001,ctx.currentTime+.18);o.start();o.stop(ctx.currentTime+.19);setTimeout(()=>ctx.close(),250);}catch(e){}
}
$('elo').addEventListener('input',()=> $('eloVal').textContent=$('elo').value+' Elo');
document.querySelectorAll('[data-color]').forEach(b=>b.onclick=()=>{chosen=b.dataset.color;document.querySelectorAll('[data-color]').forEach(x=>x.classList.toggle('active',x===b));});
$('goSetup').onclick=()=>show('setup');$('goHelp').onclick=()=>show('help');$('backHome').onclick=()=>show('home');$('helpBack').onclick=()=>show('home');
$('startGame').onclick=()=>{if(typeof Chess==='undefined'){alert('Không tải được thư viện luật cờ. Hãy bật Internet rồi mở lại tệp game.');return;}human=chosen==='r'?(Math.random()<.5?'w':'b'):chosen;aiElo=Number($('elo').value);startNew();show('game');};
$('newGame').onclick=startNew;$('mainMenu').onclick=()=>{stopTimer();show('home');};$('undo').onclick=undo;
function startNew(){stopTimer();game=new Chess();times={w:Number($('time').value)*60,b:Number($('time').value)*60};selected=null;legal=[];lastMove=null;ended=false;thinking=false;history=[];$('youSide').textContent='Bạn: '+(human==='w'?'Trắng':'Đen');$('aiLevel').textContent='AI: '+aiElo+' Elo';$('message').textContent='';$('promotion').classList.add('hidden');render();startTimer();if(game.turn()!==human)setTimeout(aiMove,250);}
function stopTimer(){if(timer){clearInterval(timer);timer=null;}}
function startTimer(){stopTimer();timer=setInterval(()=>{if(!game||ended||thinking)return;let side=game.turn();times[side]--;clocks();if(times[side]<=0){ended=true;stopTimer();$('message').textContent=side===human?'You have lost':'You have won';$('status').textContent='Hết giờ';sound('end');}},1000);clocks();}
function fmt(n){n=Math.max(0,n);return Math.floor(n/60)+':'+String(n%60).padStart(2,'0')}
function clocks(){$('yourClock').textContent=fmt(times[human]);$('aiClock').textContent=fmt(times[human==='w'?'b':'w']);}
function render(){
 const board=$('board');board.innerHTML='';const rows=human==='w'?[0,1,2,3,4,5,6,7]:[7,6,5,4,3,2,1,0];const cols=human==='w'?[0,1,2,3,4,5,6,7]:[7,6,5,4,3,2,1,0];const b=game.board();
 rows.forEach(r=>cols.forEach(c=>{const sq=document.createElement('div');const name=String.fromCharCode(97+c)+(8-r);sq.className='sq '+((r+c)%2===0?'light':'dark');if(selected===name)sq.classList.add('selected');if(legal.some(m=>m.to===name))sq.classList.add(game.get(name)?'capture':'legal');if(lastMove&&(lastMove.from===name||lastMove.to===name))sq.classList.add('last');const p=b[r][c];if(p){const span=document.createElement('span');span.className='piece '+(p.color==='w'?'white':'black');span.textContent=glyph[p.color+p.type];sq.appendChild(span);}sq.onclick=()=>clickSquare(name);board.appendChild(sq);}));
 $('turn').textContent='Lượt: '+(game.turn()==='w'?'Trắng':'Đen');$('status').textContent=game.isCheck()?'Đang bị chiếu':game.isDraw()?'Hòa':'Đang chơi';$('moves').textContent=history.join('   ');clocks();
}
function clickSquare(sq){if(ended||thinking||game.turn()!==human)return;const p=game.get(sq);if(selected&&legal.some(m=>m.to===sq)){const moves=game.moves({square:selected,verbose:true});const move=moves.find(m=>m.to===sq);if(move){if(move.flags.includes('p')){showPromotion(selected,sq);return;}makeMove(selected,sq);return;}}
 if(p&&p.color===human){selected=sq;legal=game.moves({square:sq,verbose:true});render();}else{selected=null;legal=[];render();}}
function showPromotion(from,to){const box=$('promotion');box.innerHTML='<span>Chọn quân phong:</span>';[['q','♕','Hậu'],['r','♖','Xe'],['b','♗','Tượng'],['n','♘','Mã']].forEach(([type,icon,label])=>{const b=document.createElement('button');b.className='secondary';b.textContent=icon;b.title=label;b.onclick=()=>{box.classList.add('hidden');makeMove(from,to,type);};box.appendChild(b);});box.classList.remove('hidden');}
function makeMove(from,to,promotion){if(ended)return;const mv=game.move({from,to,promotion:promotion||'q'});if(!mv)return;history.push(mv.san);lastMove={from:mv.from,to:mv.to};selected=null;legal=[];sound(mv.captured?'capture':'move');if(game.isCheckmate()){ended=true;stopTimer();$('message').textContent=game.turn()===human?'You have won':'You have lost';$('status').textContent='Chiếu hết';sound('end');}else if(game.isDraw()){ended=true;stopTimer();$('message').textContent='Ván cờ hòa';$('status').textContent='Hòa';}else if(game.isCheck()){sound('check');}render();if(!ended&&game.turn()!==human)setTimeout(aiMove,180);}
function evaluate(){if(game.isCheckmate())return game.turn()===human? -99999:99999;let score=0;const val={p:100,n:320,b:330,r:500,q:900,k:20000};const b=game.board();for(let r=0;r<8;r++)for(let c=0;c<8;c++){const p=b[r][c];if(!p)continue;let v=val[p.type];if(p.type==='p')v+=(p.color==='w'?6-r:r-1)*5;if(p.type==='n'||p.type==='b')v+= (3.5-Math.abs(3.5-c)+3.5-Math.abs(3.5-r))*4;score+=p.color===human?v:-v;}return score;}
function minimax(depth,alpha,beta,maximizing){if(depth===0||game.game_over())return evaluate();const ms=game.moves({verbose:true});ms.sort((a,b)=>(b.captured?1:0)-(a.captured?1:0));if(maximizing){let best=-Infinity;for(const m of ms){game.move(m);const v=minimax(depth-1,alpha,beta,false);game.undo();best=Math.max(best,v);alpha=Math.max(alpha,v);if(beta<=alpha)break;}return best;}else{let best=Infinity;for(const m of ms){game.move(m);const v=minimax(depth-1,alpha,beta,true);game.undo();best=Math.min(best,v);beta=Math.min(beta,v);if(beta<=alpha)break;}return best;}}
function aiMove(){if(ended||game.turn()===human)return;thinking=true;const depth=aiElo<800?1:aiElo<1300?2:aiElo<1900?2:3;setTimeout(()=>{if(ended){thinking=false;return;}let ms=game.moves({verbose:true});if(!ms.length){thinking=false;return;}ms.sort(()=>Math.random()-.5);let best=null,bestScore=-Infinity;for(const m of ms){game.move(m);let score=minimax(depth-1,-Infinity,Infinity,false);game.undo();score+=Math.random()*(aiElo<800?160:aiElo<1500?45:8);if(score>bestScore){bestScore=score;best=m;}}thinking=false;if(best)makeMove(best.from,best.to,best.promotion||'q');},30);}
function undo(){if(!game||ended&&game.isCheckmate()){}if(!game||thinking)return;game.undo();if(game.turn()!==human)game.undo();history=history.slice(0,Math.max(0,history.length-2));lastMove=null;selected=null;legal=[];ended=false;$('message').textContent='';startTimer();render();}
})();
</script></body></html>
